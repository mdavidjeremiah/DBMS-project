APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hardware_world
DB_USER=hw_user
DB_PASSWORD=hw_password

# Used by SQLAlchemy and Alembic.
DATABASE_URL=mysql+pymysql://hw_user:hw_password@127.0.0.1:3306/hardware_world

ADMIN_NAME=okuja
ADMIN_EMAIL=okuja@hardwareworld.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
SEED_DEFAULT_PASSWORD=replace-with-a-unique-seed-password-at-least-12-characters
TEMP_PASSWORD_EXPIRY_HOURS=24
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000
COOKIE_SECURE=false
